# Backend only. Export environment variables before starting; no dotenv auto-load.
GEMMA_API_KEY=
GEMMA_API_MODEL=gemma-4-26b-a4b-it
# Optional local session token (at least 32 characters); otherwise generated at launch.
TROUBLESHOOT_SESSION_TOKEN=
# Member 2 local model. No download or hosted fallback.
TROUBLESHOOT_OLLAMA_URL=http://127.0.0.1:11434
TROUBLESHOOT_OLLAMA_MODEL=gemma4:e2b
TROUBLESHOOT_OLLAMA_ALLOW_LAN=0
# Stable machine-private recovery directory; default is ./data/recovery.
TROUBLESHOOT_RECOVERY_DIR=
# Desktop changes require a scenario with human recovery. Read-only inspection is default.
TROUBLESHOOT_DESKTOP_REPAIRS=0
